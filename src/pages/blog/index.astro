---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FormattedDate from "../../components/FormattedDate.astro";

const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="Blog posts">
    <h1>Blog posts by me</h1>
    <hr>
    <section>
        <ul class="list-none m-0 p-0 flex flex-col gap-[1em]">
            {posts.map((post, index) => (
                <li>
                    <a href={`/blog/${post.id}/`}>
                        <div class="flex justify-between items-end">
                            <h4 class:list={["p-0 m-0 color-accent", index === 0 && "text-3xl"]}>{post.data.title}</h4>
                            <div class="italic color-subtext0">
                                <FormattedDate date={post.data.pubDate} />
                            </div>
                        </div>
                        <div class="color-subtext0">
                            {post.data.description}
                        </div>
                    </a>
                </li>
            ))}
        </ul>
    </section>
</BaseLayout>
