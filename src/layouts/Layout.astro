---
type Props = {
	title: string;
	description: string;
};
let { title, description } = Astro.props;
---
<!doctype html>
<html lang="en" class="bg-base text-text">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="https://github.com/ankddev.png" />
    <meta name="generator" content={Astro.generator} />
    <title>/dev/ankddev: {title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
